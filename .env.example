# Local stand only. Copy to .env and change the values.
CH_USER=dwh
CH_PASSWORD=change-me-clickhouse

VAULT_ROOT_TOKEN=change-me-root-token
# Read-only token Airflow uses for the airflow/ mount in Vault
AIRFLOW_VAULT_TOKEN=change-me-airflow-token

AIRFLOW_JWT_SECRET=change-me-jwt-secret

# Optional CoinGecko demo API key (https://www.coingecko.com/en/api). Empty = public rate limit.
COINGECKO_API_KEY=

# Image naming for connectors: local builds by default, GHCR in CI/prod, e.g.
# CONNECTOR_IMAGE_TEMPLATE=ghcr.io/<github-user>/connector-{name}:latest
CONNECTOR_IMAGE_TEMPLATE=connector-{name}:dev
DBT_IMAGE=dbt-runner:dev
